<mvc:View
    controllerName="ui5.desafio-tecnico.controller.EquipamentoEletronicoList"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc">

    <Panel accessibleRole="Region">
        <headerToolbar>
			<Toolbar>
				<Title text="{i18n>equipamentoEletronicoListTitle}"/>
				<ToolbarSpacer/>
				<SearchField 
					width="50%"/>
			</Toolbar>
		</headerToolbar>
        <Table
			id="equipamentoEletronicoList"
			headerText="{i18n>equipamentoEletronicoListTitle}"
			class="sapUiResponsiveMargin"
			width="auto"
			items="{
				path: '',
				sorter: {
					path: 'ShipperName',
					group: true
				}
			}">
        </Table>
    </Panel>
</mvc:View>