{
	"_version": "1.65.0",
	"sap.app": {
		"id": "ui5.desafio-tecnico",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"type": "application",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"equipamentosEletronicosRemote": {
				"uri": "/api/equipamento-eletronico",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.108.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "ui5.desafio-tecnico.i18n.i18n",
					"supportedLocales": [
						""
					],
					"fallbackLocale": ""
				}
			},
			"equipamentosEletronicos": {
				"dataSource": "equipamentosEletronicosRemote"
			}
		},
		"rootView": {
			"viewName": "ui5.desafio-tecnico.view.App",
			"type": "XML",
			"id": "app"
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "ui5.desafio-tecnico.view",
                "controlId": "app",
                "controlAggregation": "pages"
            },
            "routes": [
               {
                    "pattern": "",
                    "name": "gestao",
                    "target": "gestao"
                }
            ],
            "targets": {
                "gestao": {
                    "id": "gestao",
                    "name": "Gestao"
                }
            }
        },
		"contentDensities": {
			"compact": true,
			"cozy": true
		}
	}
}