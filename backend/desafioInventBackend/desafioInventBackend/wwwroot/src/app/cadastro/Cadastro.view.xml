<mvc:View
  controllerName="desafio.app.cadastro.Cadastro"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:l="sap.ui.layout"
>
  <Page title="{i18n>Cadastro.Title}"
        showNavButton="true"
		    navButtonPress=".aoNavegarUltimaPagina">
    <Panel
          class="sapUiResponsiveMargin"
          width="auto"
          expandable="{device>/system/phone}"
          expanded="{= !${device>/system/phone} }"
          accessibleRole="Region">

      <content>
        <VBox width="97%" backgroundDesign="Solid">
          <HBox class="sapUiLargeMarginBegin sapUiSmallMarginTopBottom" width="100%">
            <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop" width="50%">
              <Label text="{i18n>Cadastro.NomeInput}" required="true" displayOnly="true" labelFor="idInputNome"/>
              <Input id="idInputNome" required="true" width="100%" value="{form>/nome}"/>
            </VBox>

            <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop" width="35%">
              <Label text="{i18n>Cadastro.TipoEquipamentoSelect}" required="true" labelFor="tipoEquipamento"/>
              <Select id="tipoEquipamento" selectedKey="{form>/tipoEquipamento}"
                items="{tiposEquipamentos>/tipoEquipamentoCollection}"
                required="true" width="100%">
                <core:Item key="{tiposEquipamentos>/id}" text="{tiposEquipamentos>label}"/>
              </Select>
            </VBox>
          </HBox>
        </VBox>
        <VBox width="97%">
          <HBox class="sapUiLargeMarginBegin">
            <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop" width="20%">
              <Label text="{i18n>Cadastro.EstoqueSelect}" labelFor="idInputQuantidade" required="true"/>
              <Input id="idInputQuantidade" required="true" width="100%" value="{form>/quantidade}"/>
            </VBox>
          </HBox>
        </VBox>
      </content>
    </Panel>
    <footer>
      <OverflowToolbar>
        <ToolbarSpacer/>
        <Button text="{i18n>Cadastro.VoltarBotao}" type="Ghost" press=".aoNavegarUltimaPagina" />
        <Button text="{i18n>Cadastro.SalvarBotao}" type="Emphasized" press="aoClicarBotaoCadastrar"/>
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
