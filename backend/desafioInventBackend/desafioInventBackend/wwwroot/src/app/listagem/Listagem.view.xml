<mvc:View
    controllerName="desafio.app.listagem.Listagem"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
>
  <Page title="{i18n>Listagem.Title}">
      <content>
        <VBox>
          <Panel
            headerText="{i18n>Listagem.panelHeaderTitle}"
            class="sapUiResponsiveMargin"
            width="auto"
            expandable="{device>/system/phone}"
            expanded="{= !${device>/system/phone} }"
            accessibleRole="Region">
            <content>
              <VBox width="97%" backgroundDesign="Solid">
                <HBox class="sapUiLargeMarginBegin sapUiSmallMarginTopBottom" width="100%">
                  <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop" width="50%">
                    <Label text="Nome" displayOnly="true" labelFor="nome"/>
                    <Input id="idInputNome" width="100%" value="{/filtros/nome}"/>
                  </VBox>

                  <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop" width="35%">
                    <Label text="Tipo Equipamento" labelFor="tipoEquipamento"/>
                    <Select id="idSelectTipoEquipamento" width="100%">
                      <core:Item key="1" text="PC"/>
                      <core:Item key="2" text="Notebook"/>
                      <core:Item key="3" text="Mouse"/>
                      <core:Item key="4" text="Teclado"/>
                      <core:Item key="5" text="Celular"/>
                    </Select>
                  </VBox>
                </HBox>
              </VBox>
              <VBox width="97%" backgroundDesign="Solid">
                <HBox class="sapUiLargeMarginBegin sapUiSmallMarginTopBottom">
                  <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop">
                    <Label text="DateRangeSelection displayFormat 'yyyy/MM/dd', set via binding:" labelFor="DRS1"/>
                    <DateRangeSelection id="id" class="DRS1"
                      value= "{
                        'type': 'sap.ui.model.type.DateInterval',
                        'formatOptions': {
                          'pattern': 'yyyy/MM/dd'
                        },
                        'parts': [
                          {
                            'type': 'sap.ui.model.type.Date',
                            'path': '/start'
                          },
                          {
                            'type': 'sap.ui.model.type.Date',
                            'path': '/end'
                          }
                        ]
                      }"
                      change="handleChange"/>
                  </VBox>

                  <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop" width="20%">
                    <Label text="Estoque" labelFor="haEstoque"/>
                    <Select width="100%" id="idSelectHaEstoque" >
                      <core:Item key="1" text="TODOS"/>
                      <core:Item key="2" text="Há Estoque"/>
                      <core:Item key="3" text="Não Há Estoque"/>
                    </Select>
                  </VBox>
                  <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop">
                    <Button text="Cadastrar" class="myCustomButton" press="aoClicarBotaoCadastrar"/>
                  </VBox>
                  <VBox class="sapUiLargeMarginEnd sapUiTinyMarginTop">
                    <Button text="Pesquisar" class="myCustomButton" press="aoClicarBotaoPesquisar" />
                  </VBox>
                </HBox>
              </VBox>
            </content>
          </Panel>

          <Panel>
            <headerToolbar>
              <Toolbar>
                <Title text="{i18n>Listagem.tableHeaderTitle}"/>
              </Toolbar>
            </headerToolbar>
            <Table class="sapUiResponsiveMargin" width="auto">
              <columns>
                <Column>
                  <Text text="Nome do produto"/>
                </Column>
                <Column>
                  <Text text="Tipo do Equipamento"/>
                </Column>
                <Column>
                  <Text text="Há em estoque"/>
                </Column>
                <Column>
                  <Text text="Quantidade"/>
                </Column>
                <Column>
                  <Text text="Inclusão"/>
                </Column>
                <Column>
                  <Text text="Ações"/>
                </Column>
              </columns>
            </Table>
          </Panel>
        </VBox>
      </content>
  </Page>
</mvc:View>
